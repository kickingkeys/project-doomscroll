#!/bin/zsh
set -e
[ -f "$1" ] || { echo "usage: transcribe <video>" >&2; exit 1; }
wav="${1:r}.transcribe.wav"
/opt/homebrew/bin/ffmpeg -loglevel error -y -i "$1" -ar 16000 -ac 1 "$wav"
model=/opt/homebrew/share/whisper/ggml-large-v3-turbo-q5_0.bin
/opt/homebrew/bin/whisper-cli -m $model -f "$wav" -l auto -nt -np 2>/dev/null || /opt/homebrew/bin/whisper-cli -ng -m $model -f "$wav" -l auto -nt -np 2>/dev/null
rm -f "$wav"
